{
  "edges": [
    { "id": "e1", "source": "trigger", "target": "build-emails" },
    { "id": "e2", "source": "build-emails", "target": "send-donor" },
    { "id": "e3", "source": "send-donor", "target": "check-creator" },
    {
      "id": "e4",
      "source": "check-creator",
      "target": "send-creator",
      "sourceHandle": "true"
    },
    {
      "id": "e5",
      "source": "check-creator",
      "target": "end",
      "sourceHandle": "false"
    },
    { "id": "e6", "source": "send-creator", "target": "end" }
  ],
  "steps": [
    {
      "id": "trigger",
      "name": "Donation Received",
      "next": "build-emails",
      "type": "trigger",
      "trigger": {
        "type": "event",
        "config": { "source": "omni.crystal", "pattern": "crystal.donation.received" }
      },
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "build-emails",
      "code": {
        "inputs": { "d": "{{ steps['trigger'].output.event.data }}" },
        "source": "const d = input.d || {}; const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const creator = esc(d.creatorName || 'the creator'); const amount = esc(d.amount || ''); const donor = d.isAnonymous ? 'An anonymous supporter' : esc(d.donorName || 'A supporter'); const msg = d.message ? `<div style='margin-top:16px;padding:12px 16px;background:#f6f6f6;border-radius:8px;font-style:italic'>${esc(d.message)}</div>` : ''; const donorHtml = `<div style='max-width:560px;margin:0 auto;font-family:sans-serif;color:#111'><h2>Thank you for your donation</h2><p>We received your donation${amount ? ' of <strong>' + amount + '</strong>' : ''} to <strong>${creator}</strong>. This email is your receipt.</p>${msg}<p style='color:#888;font-size:12px;margin-top:24px'>Thank you for your support.</p></div>`; const creatorHtml = `<div style='max-width:560px;margin:0 auto;font-family:sans-serif;color:#111'><h2>You received a donation</h2><p>${donor} donated${amount ? ' <strong>' + amount + '</strong>' : ''} to <strong>${creator}</strong>.</p>${msg}</div>`; return { donorEmail: d.donorEmail || '', donorSubject: `Your donation to ${d.creatorName || 'the creator'}`, donorHtml, creatorEmail: d.creatorEmail || '', creatorSubject: `You received a donation${d.amount ? ' of ' + d.amount : ''}`, creatorHtml, hasCreatorEmail: !!d.creatorEmail };",
        "sandbox": "worker"
      },
      "name": "Build Donation Emails",
      "next": "send-donor",
      "type": "code",
      "position": { "x": 0, "y": 100 }
    },
    {
      "id": "send-donor",
      "name": "Email Donor",
      "next": "check-creator",
      "type": "email",
      "email": {
        "to": "{{steps['build-emails'].output.donorEmail}}",
        "body": "{{steps['build-emails'].output.donorHtml}}",
        "subject": "{{steps['build-emails'].output.donorSubject}}",
        "contentType": "html"
      },
      "position": { "x": 0, "y": 200 }
    },
    {
      "id": "check-creator",
      "name": "Has Creator Email?",
      "type": "condition",
      "position": { "x": 0, "y": 300 },
      "condition": {
        "expression": "{{steps['build-emails'].output.hasCreatorEmail}} === true",
        "trueBranch": "send-creator",
        "falseBranch": "end"
      }
    },
    {
      "id": "send-creator",
      "name": "Notify Creator",
      "next": "end",
      "type": "email",
      "email": {
        "to": "{{steps['build-emails'].output.creatorEmail}}",
        "body": "{{steps['build-emails'].output.creatorHtml}}",
        "subject": "{{steps['build-emails'].output.creatorSubject}}",
        "contentType": "html"
      },
      "position": { "x": 0, "y": 400 }
    },
    {
      "id": "end",
      "name": "Workflow Complete",
      "stop": { "reason": "Crystal donation emails processed", "status": "success" },
      "type": "stop",
      "position": { "x": 0, "y": 500 }
    }
  ],
  "version": "1.0",
  "executor": "hatchet",
  "settings": {
    "timeout": "2m",
    "retryPolicy": {
      "maxAttempts": 3,
      "maxInterval": "30s",
      "initialInterval": "1s",
      "backoffCoefficient": 2
    }
  }
}
