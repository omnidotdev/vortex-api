{
  "edges": [
    {
      "source": "trigger",
      "target": "build-emails"
    },
    {
      "source": "build-emails",
      "target": "send-buyer"
    },
    {
      "source": "send-buyer",
      "target": "check-seller"
    },
    {
      "source": "check-seller",
      "target": "send-seller",
      "sourceHandle": "true"
    },
    {
      "source": "check-seller",
      "target": "end",
      "sourceHandle": "false"
    },
    {
      "source": "send-seller",
      "target": "end"
    }
  ],
  "steps": [
    {
      "id": "trigger",
      "name": "Order Confirmed",
      "next": "build-emails",
      "type": "trigger",
      "trigger": {
        "type": "event",
        "config": {
          "source": "omni.halo",
          "pattern": "halo.order.confirmed"
        }
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "build-emails",
      "code": {
        "inputs": {
          "d": "{{ steps['trigger'].output.event.data }}"
        },
        "source": "const d = input.d || {}; const fmt = (c) => new Intl.NumberFormat('en-US', { style: 'currency', currency: d.currency || 'USD' }).format((c || 0) / 100); const rows = (d.lines || []).map((l) => `<tr><td style='padding:6px 0'>${l.title}${l.variantTitle ? ' - ' + l.variantTitle : ''} &times; ${l.quantity}</td><td style='padding:6px 0;text-align:right'>${fmt(l.total)}</td></tr>`).join(''); const totals = [['Subtotal', d.subtotal], d.discountTotal ? ['Discount', -d.discountTotal] : null, d.shippingTotal ? ['Shipping', d.shippingTotal] : null, d.taxTotal ? ['Tax', d.taxTotal] : null].filter(Boolean).map((t) => `<tr><td style='padding:2px 0;color:#555'>${t[0]}</td><td style='padding:2px 0;text-align:right;color:#555'>${fmt(t[1])}</td></tr>`).join(''); const summary = `<table style='width:100%;border-collapse:collapse;font-family:sans-serif;font-size:14px'>${rows}<tr><td colspan='2' style='border-top:1px solid #eee;padding-top:8px'></td></tr>${totals}<tr><td style='padding-top:6px;font-weight:700'>Total</td><td style='padding-top:6px;text-align:right;font-weight:700'>${fmt(d.total)}</td></tr></table>`; const downloads = (d.digitalDeliverables || []).length ? `<div style='margin-top:24px;padding-top:16px;border-top:1px solid #eee'><h3 style='font-size:16px;margin:0 0 8px'>Your downloads</h3>${(d.digitalDeliverables || []).map((x) => `<div style='padding:4px 0'><a href='${x.accessUrl}' style='color:#0066cc;text-decoration:none'>${x.productTitle}</a></div>`).join('')}</div>` : ''; const buyerHtml = `<div style='max-width:560px;margin:0 auto;font-family:sans-serif;color:#111'><h2>Thank you for your order</h2><p>${d.storeName} received your order <strong>${d.orderNumber}</strong>. Here is your receipt.</p>${summary}${downloads}<p style='color:#888;font-size:12px;margin-top:24px'>Questions? Just reply to this email.</p></div>`; const sellerHtml = `<div style='max-width:560px;margin:0 auto;font-family:sans-serif;color:#111'><h2>New order ${d.orderNumber}</h2><p>${d.storeName} received a new order from ${d.buyerEmail}.</p>${summary}</div>`; return { buyerEmail: d.buyerEmail || '', buyerSubject: `Your ${d.storeName} order ${d.orderNumber}`, buyerHtml, sellerEmail: d.sellerEmail || '', sellerSubject: `New order ${d.orderNumber} - ${d.storeName}`, sellerHtml, hasSeller: !!d.sellerEmail };",
        "sandbox": "worker"
      },
      "name": "Build Order Emails",
      "next": "send-buyer",
      "type": "code",
      "position": {
        "x": 0,
        "y": 100
      }
    },
    {
      "id": "send-buyer",
      "name": "Email Buyer",
      "next": "check-seller",
      "type": "email",
      "email": {
        "to": "{{steps['build-emails'].output.buyerEmail}}",
        "body": "{{steps['build-emails'].output.buyerHtml}}",
        "subject": "{{steps['build-emails'].output.buyerSubject}}",
        "contentType": "html"
      },
      "position": {
        "x": 0,
        "y": 200
      }
    },
    {
      "id": "check-seller",
      "name": "Has Seller?",
      "type": "condition",
      "position": {
        "x": 0,
        "y": 300
      },
      "condition": {
        "expression": "{{ steps['build-emails'].output.hasSeller === true }}",
        "trueBranch": "send-seller",
        "falseBranch": "end"
      }
    },
    {
      "id": "send-seller",
      "name": "Email Seller",
      "next": "end",
      "type": "email",
      "email": {
        "to": "{{steps['build-emails'].output.sellerEmail}}",
        "body": "{{steps['build-emails'].output.sellerHtml}}",
        "subject": "{{steps['build-emails'].output.sellerSubject}}",
        "contentType": "html"
      },
      "position": {
        "x": 0,
        "y": 400
      }
    },
    {
      "id": "end",
      "name": "Workflow Complete",
      "stop": {
        "reason": "Halo order emails processed",
        "status": "success"
      },
      "type": "stop",
      "position": {
        "x": 0,
        "y": 500
      }
    }
  ],
  "version": "1.0",
  "executor": "hatchet",
  "settings": {
    "timeout": "2m",
    "retryPolicy": {
      "maxAttempts": 3,
      "maxInterval": "30s",
      "initialInterval": "1s",
      "backoffCoefficient": 2
    }
  }
}
