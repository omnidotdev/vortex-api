{
  "edges": [
    { "id": "e1", "source": "trigger", "target": "build-emails" },
    { "id": "e2", "source": "build-emails", "target": "send-sponsor" },
    { "id": "e3", "source": "send-sponsor", "target": "check-creator" },
    { "id": "e4", "source": "check-creator", "target": "send-creator", "sourceHandle": "true" },
    { "id": "e5", "source": "check-creator", "target": "end", "sourceHandle": "false" },
    { "id": "e6", "source": "send-creator", "target": "end" }
  ],
  "steps": [
    {
      "id": "trigger",
      "name": "Sponsorship Created",
      "next": "build-emails",
      "type": "trigger",
      "trigger": { "type": "event", "config": { "source": "omni.crystal", "pattern": "crystal.sponsorship.created" } },
      "position": { "x": 0, "y": 0 }
    },
    {
      "id": "build-emails",
      "code": {
        "inputs": { "d": "{{ steps['trigger'].output.event.data }}" },
        "source": "const d = input.d || {}; const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); const creator = esc(d.creatorName || 'the creator'); const amount = esc(d.amount || ''); const freq = esc(d.frequency || ''); const per = freq ? '/' + freq.replace(/ly$/, '') : ''; const tier = d.tierName ? ' at the ' + esc(d.tierName) + ' tier' : ''; const sponsor = d.isAnonymous ? 'An anonymous supporter' : esc(d.sponsorName || 'A supporter'); const sponsorHtml = `<div style='max-width:560px;margin:0 auto;font-family:sans-serif;color:#111'><h2>Thank you for your sponsorship</h2><p>You're now sponsoring <strong>${creator}</strong>${tier}${amount ? ' for <strong>' + amount + per + '</strong>' : ''}. This email is your receipt.</p></div>`; const creatorHtml = `<div style='max-width:560px;margin:0 auto;font-family:sans-serif;color:#111'><h2>You have a new sponsor</h2><p>${sponsor} started sponsoring you${tier}${amount ? ' for <strong>' + amount + per + '</strong>' : ''}.</p></div>`; return { sponsorEmail: d.sponsorEmail || '', sponsorSubject: `Your sponsorship of ${d.creatorName || 'the creator'}`, sponsorHtml, creatorEmail: d.creatorEmail || '', creatorSubject: 'You have a new sponsor', creatorHtml, hasCreatorEmail: !!d.creatorEmail };",
        "sandbox": "worker"
      },
      "name": "Build Sponsorship Emails",
      "next": "send-sponsor",
      "type": "code",
      "position": { "x": 0, "y": 100 }
    },
    {
      "id": "send-sponsor",
      "name": "Email Sponsor",
      "next": "check-creator",
      "type": "email",
      "email": { "to": "{{steps['build-emails'].output.sponsorEmail}}", "body": "{{steps['build-emails'].output.sponsorHtml}}", "subject": "{{steps['build-emails'].output.sponsorSubject}}", "contentType": "html" },
      "position": { "x": 0, "y": 200 }
    },
    {
      "id": "check-creator",
      "name": "Has Creator Email?",
      "type": "condition",
      "position": { "x": 0, "y": 300 },
      "condition": { "expression": "{{steps['build-emails'].output.hasCreatorEmail}} === true", "trueBranch": "send-creator", "falseBranch": "end" }
    },
    {
      "id": "send-creator",
      "name": "Notify Creator",
      "next": "end",
      "type": "email",
      "email": { "to": "{{steps['build-emails'].output.creatorEmail}}", "body": "{{steps['build-emails'].output.creatorHtml}}", "subject": "{{steps['build-emails'].output.creatorSubject}}", "contentType": "html" },
      "position": { "x": 0, "y": 400 }
    },
    {
      "id": "end",
      "name": "Workflow Complete",
      "stop": { "reason": "Crystal sponsorship-created emails processed", "status": "success" },
      "type": "stop",
      "position": { "x": 0, "y": 500 }
    }
  ],
  "version": "1.0",
  "executor": "hatchet",
  "settings": { "timeout": "2m", "retryPolicy": { "maxAttempts": 3, "maxInterval": "30s", "initialInterval": "1s", "backoffCoefficient": 2 } }
}
