{
  "name": "@omnidotdev/vortex-api",
  "private": true,
  "license": "MIT",
  "main": "build/server.js",
  "module": "build/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development GRAPHILE_ENV=development bun run --watch src/server.ts",
    "test": "bun --env-file .env.local test src/__tests__/locks.test.ts src/__tests__/eventSchema.test.ts src/__tests__/integration/dispatch.test.ts",
    "test:db": "bun --env-file .env.local test src/__tests__/auth/ src/__tests__/workflows/",
    "test:watch": "bun --env-file .env.local test --watch src/__tests__/locks.test.ts src/__tests__/eventSchema.test.ts src/__tests__/integration/dispatch.test.ts",
    "build": "bun build --target node --outdir build src/server.ts src/instrumentation.ts",
    "start": "NODE_ENV=production GRAPHILE_ENV=production bun db:migrate:only && NODE_ENV=production GRAPHILE_ENV=production bun run --import ./build/instrumentation.js build/server.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "knip": "knip-bun",
    "db:setup": "bun src/scripts/db/setupDatabase.ts",
    "db:check": "bun --env-file .env.local drizzle-kit check --config src/lib/config/drizzle.config.ts",
    "db:generate": "bun --env-file .env.local drizzle-kit generate --config src/lib/config/drizzle.config.ts",
    "db:migrate": "bun --env-file .env.local drizzle-kit migrate --config src/lib/config/drizzle.config.ts && GRAPHILE_ENV=development bun graphql:generate",
    "db:migrate:only": "bun --env-file .env.local drizzle-kit migrate --config src/lib/config/drizzle.config.ts",
    "db:migrate:drop": "bun --env-file .env.local drizzle-kit drop --config src/lib/config/drizzle.config.ts",
    "db:pull": "bun --env-file .env.local drizzle-kit introspect --config src/lib/config/drizzle.config.ts",
    "db:push": "bun --env-file .env.local drizzle-kit push --config src/lib/config/drizzle.config.ts",
    "db:seed": "NODE_ENV=development bun run --env-file .env.local src/scripts/db/seedDatabase.ts",
    "catalog:check": "bun run src/scripts/checkCatalogFreshness.ts",
    "catalog:generate": "cd ../vortex-worker && bun catalog:generate",
    "db:studio": "bun --env-file .env.local drizzle-kit studio --config src/lib/config/drizzle.config.ts --port 4985",
    "db:up": "bun --env-file .env.local drizzle-kit up --config src/lib/config/drizzle.config.ts",
    "graphql:generate": "GRAPHILE_ENV=development bun run --env-file .env.local src/scripts/generateGraphqlSchema.ts",
    "prepare": "husky"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/bun": "^1.3.5",
    "@types/ms": "^2.1.0",
    "drizzle-kit": "^0.31.8",
    "drizzle-seed": "^0.3.1",
    "husky": "^9.1.7",
    "knip": "^5.77.0",
    "replace-in-file": "^8.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@activepieces/pieces-framework": "^0.23.0",
    "@aws-sdk/client-s3": "^3.995.0",
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/graphql-yoga": "^1.4.0",
    "@envelop/generic-auth": "^11.0.0",
    "@envelop/opentelemetry": "^9.0.0",
    "@envelop/parser-cache": "^10.0.0",
    "@envelop/validation-cache": "^10.0.0",
    "@escape.tech/graphql-armor": "^3.1.7",
    "@graphile/pg-aggregates": "^0.2.0-rc.1",
    "@graphile/simplify-inflection": "^8.0.0-rc.2",
    "@graphql-yoga/plugin-disable-introspection": "^2.19.0",
    "@hatchet-dev/typescript-sdk": "^1.10.3",
    "@iggy.rs/sdk": "^1.0.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.68.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.210.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.210.0",
    "@opentelemetry/resources": "^2.4.0",
    "@opentelemetry/sdk-logs": "^0.210.0",
    "@opentelemetry/sdk-node": "^0.210.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@sentry/bun": "^10.38.0",
    "@tanstack/query-core": "^5.90.12",
    "@temporalio/client": "^1.15.0",
    "cron-parser": "^5.4.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.19",
    "elysia-rate-limit": "^4.2.0",
    "fflate": "^0.8.2",
    "grafast": "^1.0.0-rc.3",
    "graphile-export": "^1.0.0-rc.2",
    "graphql": "^16.12.0",
    "graphql-yoga": "^5.18.0",
    "jose": "^6.1.3",
    "ms": "^2.1.3",
    "pg": "^8.16.3",
    "postgraphile": "^5.0.0-rc.3",
    "postgraphile-plugin-connection-filter": "^3.0.0-rc.1",
    "redis": "^5.0.0",
    "ts-pattern": "^5.9.0"
  },
  "overrides": {
    "graphql": "^16.12.0",
    "grafast": "^1.0.0-rc.3"
  }
}
