{
  "name": "@omnidotdev/vortex-api",
  "version": "0.0.0",
  "private": true,
  "author": "Omni <team@omni.dev>",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.11",
  "main": "build/server.js",
  "module": "build/server.js",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development GRAPHILE_ENV=development bun run --watch src/server.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "build": "bun build --target node --outdir build src/server.ts src/instrumentation.ts",
    "start": "NODE_ENV=production GRAPHILE_ENV=production bun db:migrate:repair && NODE_ENV=production GRAPHILE_ENV=production bun db:migrate:prod && NODE_ENV=production GRAPHILE_ENV=production bun run --import ./build/instrumentation.js build/server.js",
    "db:migrate:repair": "bun --env-file .env.local src/scripts/db/repairMigrations.ts",
    "db:migrate:prod": "bun --env-file .env.local src/scripts/db/migrate.ts",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "knip": "knip-bun",
    "authz:reconcile": "bun --env-file .env.local src/scripts/authz/reconcile.ts",
    "db:setup": "bun src/scripts/db/setupDatabase.ts",
    "db:check": "bun --env-file .env.local drizzle-kit check --config src/lib/config/drizzle.config.ts",
    "db:generate": "bun --env-file .env.local drizzle-kit generate --config src/lib/config/drizzle.config.ts",
    "db:migrate": "bun --env-file .env.local drizzle-kit migrate --config src/lib/config/drizzle.config.ts && GRAPHILE_ENV=development bun graphql:generate",
    "db:migrate:only": "bun --env-file .env.local drizzle-kit migrate --config src/lib/config/drizzle.config.ts",
    "db:migrate:drop": "bun --env-file .env.local drizzle-kit drop --config src/lib/config/drizzle.config.ts",
    "db:pull": "bun --env-file .env.local drizzle-kit introspect --config src/lib/config/drizzle.config.ts",
    "db:push": "bun --env-file .env.local drizzle-kit push --config src/lib/config/drizzle.config.ts",
    "db:seed": "NODE_ENV=development bun run --env-file .env.local src/scripts/db/seedDatabase.ts",
    "catalog:check": "bun run src/scripts/checkCatalogFreshness.ts",
    "catalog:generate": "cd ../vortex-worker && bun catalog:generate",
    "db:studio": "bun --env-file .env.local drizzle-kit studio --config src/lib/config/drizzle.config.ts --port 4985",
    "db:up": "bun --env-file .env.local drizzle-kit up --config src/lib/config/drizzle.config.ts",
    "graphql:generate": "GRAPHILE_ENV=development bun run --env-file .env.local src/scripts/generateGraphqlSchema.ts",
    "prepare": "husky"
  },
  "trustedDependencies": [
    "@biomejs/biome"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@types/bun": "^1.4.2",
    "@types/ms": "^2.1.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "husky": "^9.1.7",
    "knip": "^6.36.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@activepieces/pieces-framework": "^0.32.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/graphql-yoga": "^1.4.1",
    "@envelop/generic-auth": "^11.2.1",
    "@envelop/opentelemetry": "^9.2.1",
    "@envelop/parser-cache": "^10.2.1",
    "@envelop/validation-cache": "^10.2.1",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@graphile/pg-aggregates": "0.2.0-rc.2",
    "@graphile/simplify-inflection": "^8.0.0",
    "@graphql-yoga/plugin-disable-introspection": "^2.25.1",
    "@hatchet-dev/typescript-sdk": "^1.33.1",
    "@omnidotdev/providers": "github:omnidotdev/providers#1c99594",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/bun": "^10.75.0",
    "@smithy/node-http-handler": "^4.12.1",
    "@tanstack/query-core": "^5.103.1",
    "@temporalio/client": "^1.24.0",
    "apache-iggy": "0.8.0",
    "cron-parser": "^5.10.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.30",
    "elysia-rate-limit": "^4.6.3",
    "fflate": "^0.8.3",
    "grafast": "^1.0.2",
    "graphile-export": "^1.0.1",
    "graphql": "^16.14.0",
    "graphql-yoga": "^5.24.1",
    "iovalkey": "^0.4.0",
    "jose": "^6.2.12",
    "ms": "^2.1.3",
    "pg": "^8.23.0",
    "postgraphile": "^5.0.3",
    "postgraphile-plugin-connection-filter": "3.0.0-rc.3"
  },
  "overrides": {
    "graphql": "^16.13.2",
    "grafast": "^1.0.0",
    "pg-sql2": "^5.0.0"
  }
}
