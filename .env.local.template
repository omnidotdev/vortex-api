# database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vortex?schema=public"

# payment processing
# https://docs.stripe.com/keys
STRIPE_API_KEY=""
# https://docs.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# GraphQL
# https://escape.tech/graphql-armor/docs/plugins/cost-limit
GRAPHQL_COMPLEXITY_MAX_COST="2000"

# allowed origins for CORS (comma-separated) (https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Access-Control-Allow-Origin)
CORS_ALLOWED_ORIGINS="https://localhost:3000"

# Auth server base URL (OIDC provider)
AUTH_BASE_URL="https://localhost:8000"

# Condition to toggle `useAuth` plugin in development (production is unchanged). `true` to protect all routes
PROTECT_ROUTES="true"

# Set to `1` to receive debug logs from `useAuth` plugin
AUTH_DEBUG=""

# Encryption key for sensitive data (integration credentials, etc.)
# Generate with: openssl rand -base64 32
# Must be exactly 32 bytes (256 bits) when base64-decoded
ENCRYPTION_KEY=""

# Redis URL for distributed locking (optional)
# Required for multi-instance deployments to prevent duplicate cron triggers
# Leave empty for single-instance deployments
REDIS_URL=""

# OpenTelemetry / HyperDX (optional in dev, recommended in prod)
# Endpoint for OTLP exporter (e.g., https://observability.omni.dev)
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Headers for OTLP exporter (format: "key1=value1,key2=value2")
# For HyperDX: "authorization=<api-key>"
OTEL_EXPORTER_OTLP_HEADERS=""
# Service name shown in traces (default: vortex-api)
OTEL_SERVICE_NAME="vortex-api"
