# database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vortex?schema=public"

# payment processing
# https://docs.stripe.com/keys
STRIPE_API_KEY=""
# https://docs.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# GraphQL
# https://escape.tech/graphql-armor/docs/plugins/cost-limit
GRAPHQL_MAX_COMPLEXITY_COST="2000"

# allowed origins for CORS (comma-separated) (https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Access-Control-Allow-Origin)
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Auth server base URL (OIDC provider)
AUTH_BASE_URL="https://localhost:8000"

# Condition to toggle `useAuth` plugin in development (production is unchanged). `true` to protect all routes
PROTECT_ROUTES="true"

# Set to `1` to receive debug logs from `useAuth` plugin
AUTH_DEBUG=""

# Encryption key for sensitive data (integration credentials, etc.)
# Generate with: openssl rand -base64 32
# Must be exactly 32 bytes (256 bits) when base64-decoded
ENCRYPTION_KEY=""

# Hatchet workflow engine token
# https://docs.hatchet.run
HATCHET_CLIENT_TOKEN=""

# Cache URL for distributed locking (optional)
# Required for multi-instance deployments to prevent duplicate cron triggers
# Leave empty for single-instance deployments
CACHE_URL=""

# Shared secret between vortex-api and the edge worker (vortex-edge-worker)
# Defaults to "dev-internal-secret" when unset in development
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=""

# Temporal workflow engine (optional, alternative executor)
TEMPORAL_ADDRESS=""
TEMPORAL_NAMESPACE=""
TEMPORAL_TASK_QUEUE=""

# Worker URL (for proxying execute-step)
WORKER_URL=""

# Billing (Aether)
BILLING_BASE_URL=""
BILLING_WEBHOOK_SECRET=""
BILLING_SERVICE_API_KEY=""

# PDP authorization (Warden)
AUTHZ_API_URL=""
AUTHZ_WEBHOOK_SECRET=""

# Webhook secrets (inbound from other services)
AUTH_WEBHOOK_SECRET=""
IDP_WEBHOOK_SECRET=""
EMAIL_WEBHOOK_SECRET=""
SEARCH_BOOTSTRAP_WEBHOOK_SECRET=""
AUDIT_WEBHOOK_SECRET=""

# Platform organization (owns built-in event schemas)
PLATFORM_ORG_ID=""

# Public URL for OAuth callbacks
VORTEX_PUBLIC_URL=""

# OAuth provider credentials (optional, enables integration auth)
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
DISCORD_OAUTH_CLIENT_ID=""
DISCORD_OAUTH_CLIENT_SECRET=""
SLACK_OAUTH_CLIENT_ID=""
SLACK_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Plugin storage (S3-compatible, optional)
PLUGIN_STORAGE_BUCKET=""
PLUGIN_STORAGE_BASE_URL=""

# Logging
LOG_LEVEL=""

# OpenTelemetry / HyperDX (optional in dev, recommended in prod)
# Endpoint for OTLP exporter (e.g., https://observability.omni.dev)
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Headers for OTLP exporter (format: "key1=value1,key2=value2")
# For HyperDX: "authorization=<api-key>"
OTEL_EXPORTER_OTLP_HEADERS=""
# Service name shown in traces (default: vortex-api)
OTEL_SERVICE_NAME="vortex-api"
