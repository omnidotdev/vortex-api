# database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vortex?schema=public"

# payment processing
# https://docs.stripe.com/keys
STRIPE_API_KEY=""
# https://docs.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=""

# GraphQL
# https://escape.tech/graphql-armor/docs/plugins/cost-limit
GRAPHQL_MAX_COMPLEXITY_COST="2000"

# allowed origins for CORS (comma-separated) (https://developer.mozilla.org/en-US/docs/Web/HTTP/Reference/Headers/Access-Control-Allow-Origin)
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Auth server base URL (OIDC provider)
AUTH_BASE_URL="https://localhost:8000"

# Condition to toggle `useAuth` plugin in development (production is unchanged). `true` to protect all routes
PROTECT_ROUTES="true"

# Set to `1` to receive debug logs from `useAuth` plugin
AUTH_DEBUG=""

# Encryption key for sensitive data (integration credentials, etc.)
# Generate with: openssl rand -base64 32
# Must be exactly 32 bytes (256 bits) when base64-decoded
ENCRYPTION_KEY=""

# Hatchet workflow engine token
# https://docs.hatchet.run
HATCHET_CLIENT_TOKEN=""

# Cache URL for distributed locking (optional)
# Required for multi-instance deployments to prevent duplicate cron triggers
# Leave empty for single-instance deployments
CACHE_URL=""

# Shared secret for internal service-to-service auth
# Defaults to "dev-internal-secret" when unset in development
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=""

# Temporal workflow engine (optional, alternative executor)
TEMPORAL_ADDRESS=""
TEMPORAL_NAMESPACE=""
TEMPORAL_TASK_QUEUE=""

# Worker URL (for proxying execute-step)
WORKER_URL=""

# Billing (Aether)
BILLING_BASE_URL=""
BILLING_WEBHOOK_SECRET=""
BILLING_SERVICE_API_KEY=""

# PDP authorization (Warden)
# Required in production. Authorization checks fail closed (deny) when this is
# unset, so a production boot without it is rejected by validateEnv.
AUTHZ_API_URL=""
AUTHZ_WEBHOOK_SECRET=""

# Webhook secrets (inbound from other services)
AUTH_WEBHOOK_SECRET=""
IDP_WEBHOOK_SECRET=""
EMAIL_WEBHOOK_SECRET=""
SEARCH_BOOTSTRAP_WEBHOOK_SECRET=""
AUDIT_WEBHOOK_SECRET=""

# Platform organization (owns built-in event schemas)
PLATFORM_ORG_ID=""

# Public URL for OAuth callbacks
VORTEX_PUBLIC_URL=""

# OAuth provider credentials (optional, enables integration auth)
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
DISCORD_OAUTH_CLIENT_ID=""
DISCORD_OAUTH_CLIENT_SECRET=""
SLACK_OAUTH_CLIENT_ID=""
SLACK_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Plugin storage (S3-compatible, optional)
PLUGIN_STORAGE_BUCKET=""
PLUGIN_STORAGE_BASE_URL=""

# Logging
LOG_LEVEL=""

# OpenTelemetry / HyperDX (optional in dev, recommended in prod)
# Endpoint for OTLP exporter (e.g., https://observability.omni.dev)
OTEL_EXPORTER_OTLP_ENDPOINT=""
# Headers for OTLP exporter (format: "key1=value1,key2=value2")
# For HyperDX: "authorization=<api-key>"
OTEL_EXPORTER_OTLP_HEADERS=""
# Service name shown in traces (default: vortex-api)
OTEL_SERVICE_NAME="vortex-api"

# Event log retention (optional). Days of event_log history to keep; a
# background sweep prunes older rows so the table cannot grow without bound
# (important for self-hosted single-volume deployments). Default 90. Set to 0
# to disable pruning (keep events forever). Events older than the window can no
# longer be replayed via POST /api/v1/events/replay.
EVENT_LOG_RETENTION_DAYS=""

# Consumer webhook secrets for scripts/seedSubscriptions.ts (optional; only
# needed to (re)register outbound event subscriptions). Each must equal the
# target service's own webhook secret. A subscription whose secret is unset is
# skipped by the seed.
TRELLIS_BILLING_WEBHOOK_SECRET=""
ARBOR_BILLING_WEBHOOK_SECRET=""
RUNA_BILLING_WEBHOOK_SECRET=""
BACKFEED_BILLING_WEBHOOK_SECRET=""
SYNAPSE_BILLING_WEBHOOK_SECRET=""
VORTEX_BILLING_WEBHOOK_SECRET=""
ARBOR_IDP_WEBHOOK_SECRET=""
RUNA_IDP_WEBHOOK_SECRET=""
SYNAPSE_IDP_WEBHOOK_SECRET=""
BACKFEED_IDP_WEBHOOK_SECRET=""
MYFI_MANTLE_WEBHOOK_SECRET=""
HALO_CATALOG_WEBHOOK_SECRET=""
AETHER_IDP_WEBHOOK_SECRET=""

# Bifrost workspace billing + identity delivery (optional). When set, vortex-api
# seeds the bifrost-entitlements (aether.entitlement.* -> /webhooks/billing) and
# bifrost-idp-org-deleted (gatekeeper.organization.deleted -> /webhooks/idp)
# subscriptions at boot. Each secret must equal Bifrost's BILLING_WEBHOOK_SECRET
# / AUTH_WEBHOOK_SECRET; a subscription whose secret is unset is skipped.
BIFROST_API_URL=""
BIFROST_BILLING_WEBHOOK_SECRET=""
BIFROST_IDP_WEBHOOK_SECRET=""

# Optional: Keystone identity delivery. gatekeeper.organization.deleted,
# gatekeeper.member.removed, and gatekeeper.user.deleted -> /webhooks/idp, so a
# deleted workspace's sites are deleted and form emails stop for a member who
# left. The secret must equal keystone-api's AUTH_WEBHOOK_SECRET; both must be
# set for the subscriptions to be seeded.
KEYSTONE_API_URL=""
KEYSTONE_IDP_WEBHOOK_SECRET=""

# Optional: Fractal workspace teardown. gatekeeper.organization.deleted ->
# fractal-api /webhooks/idp, which deletes the workspace's projects. The secret
# must equal fractal-api's IDP_WEBHOOK_SECRET; both must be set.
FRACTAL_API_URL=""
FRACTAL_IDP_WEBHOOK_SECRET=""
# Aether /webhooks/idp (at BILLING_BASE_URL), must match Aether's IDP_WEBHOOK_SECRET
AETHER_IDP_WEBHOOK_SECRET=""

# Optional: Eyrie account deletion. gatekeeper.user.deleted -> eyrie-api
# /webhooks/idp, which deletes the account's circle memberships, locations, and
# SOS alerts. The secret must equal eyrie-api's AUTH_WEBHOOK_SECRET; both must
# be set for the subscription to be seeded.
EYRIE_API_URL=""
EYRIE_IDP_WEBHOOK_SECRET=""

# Optional: workspace teardown in more products. gatekeeper.organization.deleted
# -> each product's /webhooks/idp, which deletes what it keeps for the
# workspace. Each secret must equal the product's own identity webhook secret
# (IDP_WEBHOOK_SECRET for herald-api, signet-api, myfi-api, and mantle-api;
# AUTH_WEBHOOK_SECRET for crystal-api and halo-api); a product's subscription is
# seeded only when its URL (HERALD_API_URL above for Herald) and secret are set.
HERALD_IDP_WEBHOOK_SECRET=""
SIGNET_API_URL=""
SIGNET_IDP_WEBHOOK_SECRET=""
MYFI_API_URL=""
MYFI_IDP_WEBHOOK_SECRET=""
MANTLE_API_URL=""
MANTLE_IDP_WEBHOOK_SECRET=""
CRYSTAL_API_URL=""
CRYSTAL_IDP_WEBHOOK_SECRET=""
HALO_API_URL=""
HALO_IDP_WEBHOOK_SECRET=""
